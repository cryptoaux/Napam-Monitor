# Example configuration only. Replace these placeholders locally.
# Supply real credentials through a secure secret mechanism; never commit them.

LOG_LEVEL=info
MONITOR_COMPANIES_FILE=companies.json
MONITOR_OUTPUT_PATH=public/data.json

# Optional structured error tracking for production robustness.
# Error tracking is DISABLED by default and is safe to leave unset.
# To enable error tracking, set ERROR_TRACKING_ENABLED=true and provide a valid DSN.
# Never commit a real DSN; use GitHub Actions secrets or environment configuration instead.
#
# ERROR_TRACKING_ENABLED=false
# ERROR_TRACKING_DSN=

# Company credentials consolidated into a single JSON secret.
# This replaces the legacy per-company env-name configuration (COMPANY_N_TIN/PASSWORD).
# The JSON payload is validated against the application's credential schema.
#
# Format: JSON array of objects with id, tin, and password fields.
# Each object represents one company's credentials.
#
# Example with one company:
# COMPANIES_CREDENTIALS_JSON='[{"id":"company_01","tin":"example-company-tin","password":"example-company-password"}]'
#
# Example with multiple companies:
# COMPANIES_CREDENTIALS_JSON='[{"id":"company_01","tin":"tin-001","password":"pass-001"},{"id":"company_02","tin":"tin-002","password":"pass-002"}]'
#
# In GitHub Actions, store the full JSON payload as a repository secret named COMPANIES_CREDENTIALS_JSON
# and reference it with ${{ secrets.COMPANIES_CREDENTIALS_JSON }}.

COMPANIES_CREDENTIALS_JSON='[{"id":"company_01","tin":"example-company-tin","password":"example-company-password"}]'
